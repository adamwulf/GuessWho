// GuessWhoMailExtension-Release.xcconfig
// Release-configuration identifiers for the GuessWhoMailExtension target. Wired
// as the extension's Release baseConfigurationReference.

#include "GuessWhoMailExtension-Shared.xcconfig"

// Bundle id — must stay prefixed by the app bundle id (…guesswho ⊃ …guesswho.mail).
PRODUCT_BUNDLE_IDENTIFIER = com.milestonemade.guesswho.mail

// Display name in Mail's Settings → Extensions. The Debug counterpart is
// "GuessWho Debug".
GUESSWHO_MAIL_EXTENSION_DISPLAY_NAME = GuessWho

// App wake scheme — must match GUESSWHO_LINKEDIN_URL_SCHEME in
// GuessWho-Release.xcconfig. The compose popover opens a contact in the app
// with `<scheme>://open-contact?id=…`.
GUESSWHO_LINKEDIN_URL_SCHEME = guesswho-linkedin
