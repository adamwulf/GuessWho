// GuessWhoMailExtension-Shared.xcconfig
// Config-invariant TARGET-level settings for the GuessWhoMailExtension target —
// a NATIVE macOS MailKit app extension (not Catalyst) that highlights mail from
// favorite contacts, journals incoming-message metadata for the app, and adds
// a recipient-details popover to Mail's compose window. The target lives in
// App/guesswho-cli.xcodeproj, NOT the app project: the app target's "Build and
// Embed GuessWhoMailExtension" Run Script builds it in a nested xcodebuild
// (next to guesswho-cli, sharing its derived data), copies the appex to
// GuessWho.app/Contents/PlugIns/, and signs it. That phase runs only for Mac
// Catalyst, so iOS builds never build or ship it.
//
// The per-configuration settings — bundle id and display name — live in
// GuessWhoMailExtension-Debug.xcconfig and GuessWhoMailExtension-Release.xcconfig,
// each wired as that configuration's baseConfigurationReference in the project.

#include "SharedVersion.xcconfig"

PRODUCT_NAME = $(TARGET_NAME)

// Signing. Sandboxed (Mail loads only sandboxed extensions) with the App Group
// as its only other entitlement. REGISTER_APP_GROUPS stays off: the extension
// uses only the <TeamID>.-prefixed macOS group form, which is authorized by
// code signature and needs no developer-portal registration. NOTE: the
// shipping embed path does NOT sign here — the app's "Build and Embed
// GuessWhoMailExtension" Run Script builds this target with
// CODE_SIGNING_ALLOWED=NO and signs the embedded copy itself (hardened
// runtime, $(GUESSWHO_APP_GROUP) sed-expanded into the entitlements); these
// settings apply when building/signing this target standalone.
DEVELOPMENT_TEAM = T68Z94627S
CODE_SIGN_STYLE = Automatic
ENABLE_APP_SANDBOX = YES
ENABLE_HARDENED_RUNTIME = YES
CODE_SIGN_ENTITLEMENTS = GuessWhoMailExtension/GuessWhoMailExtension.entitlements

// App Group — the app's Mac Catalyst group (GUESSWHO_APP_GROUP[sdk=macosx*] in
// GuessWho-Debug/Release.xcconfig; Debug and Release share it). This target is
// macOS-only, so the <TeamID>. form is the only one. Feeds the
// GuessWhoAppGroup Info.plist key the shared code (and the log bootstrap)
// resolves the container from, and the entitlement when this target is signed
// standalone. The embedded copy's entitlement is expanded by the app's embed
// script from the APP's GUESSWHO_APP_GROUP, and that script fails the build
// when the two values differ, so they can't drift.
GUESSWHO_APP_GROUP = $(DEVELOPMENT_TEAM).com.milestonemade.guesswho

// Platform: NATIVE macOS. MailKit is unavailable to Mac Catalyst, so this
// overrides the project-level SDKROOT = iphoneos. MailKit needs macOS 12; the
// floor matches the project's macOS 14.
SDKROOT = macosx
SUPPORTED_PLATFORMS = macosx
MACOSX_DEPLOYMENT_TARGET = 14.0

// No Swift packages. Linking the app's package graph (GuessWhoLogging, …)
// into a macOS target built in the same xcodebuild as the Catalyst app makes
// archive planning emit duplicate package build commands (see the app's
// "Build and Embed guesswho-cli" phase), so the extension stays
// Foundation/AppKit/SwiftUI/MailKit only. The file format it shares with the
// app is compiled from App/GuessWhoMailShared/ into both targets.

// Swift
CLANG_ENABLE_MODULES = YES
SWIFT_VERSION = 6.0
SWIFT_EMIT_LOC_STRINGS = YES

// Info.plist
GENERATE_INFOPLIST_FILE = NO
INFOPLIST_FILE = GuessWhoMailExtension/Info.plist

// Embedded app extension: Contents/PlugIns/<name>.appex/Contents/MacOS/<exe>.
// The only rpath is the appex's OWN Contents/Frameworks — never the host's
// GuessWho.app/Contents/Frameworks (the app-extension template's
// @executable_path/../../../../Frameworks), which holds the CATALYST variants
// of the package frameworks a native macOS Mach-O cannot load. The nested
// build links every package product statically today; if it ever produces a
// "…_PackageProduct" framework, the embed script copies the macOS variant
// here.
SKIP_INSTALL = YES
LD_RUNPATH_SEARCH_PATHS = $(inherited) @executable_path/../Frameworks
