<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Mail loads only sandboxed extensions. -->
	<key>com.apple.security.app-sandbox</key>
	<true/>
	<!-- The App Group ONLY (no iCloud, no Contacts, no network): the extension
	     reads the contact cache the app publishes and appends to the
	     incoming-message journal the app drains, both in the shared container.
	     The copy embedded in GuessWho.app is signed by the app's "Build and
	     Embed GuessWhoMailExtension" phase, which replaces the placeholder
	     (with sed) by the APP target's GUESSWHO_APP_GROUP — the
	     <TeamID>.com.milestonemade.guesswho group of the app's
	     GuessWho-MacCatalyst.entitlements — and fails the build when that
	     differs from the extension's GuessWhoAppGroup Info.plist value (from
	     GUESSWHO_APP_GROUP in Config/GuessWhoMailExtension-Shared.xcconfig), so
	     the two can't drift. Only a standalone build of this target expands it
	     from the extension's own xcconfig. -->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>$(GUESSWHO_APP_GROUP)</string>
	</array>
</dict>
</plist>
